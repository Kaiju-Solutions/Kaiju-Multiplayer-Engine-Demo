<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-container" style="flex-grow: 1; align-items: center; justify-content: flex-end; padding-bottom: 10px; background-color: rgba(0, 0, 0, 0);">
        <ui:VisualElement name="menu-panel" style="align-items: center; background-color: rgb(45, 45, 45); padding: 20px; border-radius: 15px;">
            <ui:VisualElement name="button-container" style="flex-direction: row; justify-content: center;">
                <ui:Button name="host-button" text="Host" style="width: 150px; height: 40px; margin: 5px; font-size: 16px; -unity-font-style: bold;"/>
                <ui:Button name="connect-button" text="Connect" style="width: 150px; height: 40px; margin: 5px; font-size: 16px; -unity-font-style: bold;"/>
                <ui:Button name="disconnect-button" text="Disconnect" style="width: 150px; height: 40px; margin: 5px; font-size: 16px; -unity-font-style: bold; display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
